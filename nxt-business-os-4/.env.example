NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only email delivery settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM=
CRON_SECRET=

# Enable only after setting an approved project spend cap in AI Gateway.
AI_CHAT_ENABLED=false
AI_GATEWAY_MODEL=
# On Vercel use automatic VERCEL_OIDC_TOKEN; locally use a server-only Gateway key.
AI_GATEWAY_API_KEY=

# Native internal live Master Tracker — server-only; configure through hosting controls.
MASTER_TRACKER_WORKSPACE_ID=
MASTER_TRACKER_SITES_TOKEN=
MASTER_TRACKER_FEED_SECRET=
